{
  "name": "@telechir/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "check": "npm run format:check && npm run typecheck && npm test && npm run dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "jose": "^6.1.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
